# Required
ACP_BRIDGE_TOKEN=replace-with-long-random-secret
CURSOR_API_KEY=replace-with-cursor-api-key

# Server
ACP_BRIDGE_HOST=127.0.0.1
ACP_BRIDGE_PORT=8000
ALLOWED_ORIGINS=https://bergamota.dev,https://www.bergamota.dev

# Sessions
SESSION_IDLE_TIMEOUT_SEC=900
SESSION_MAX_LIFETIME_SEC=3600
MAX_CONCURRENT_SESSIONS=10
SESSION_WORKDIR_ROOT=/tmp/cursor-acp-sessions
REAPER_INTERVAL_SEC=5

# Rate limits (in-memory)
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_SESSION_PER_MINUTE=30
RATE_LIMIT_GLOBAL_DAILY=10000

# ACP subprocess (override in tests)
ACP_AGENT_COMMAND=agent
ACP_AGENT_ARGS=acp
