# Example reverse proxy for bergamota.dev -> Docker on port 3027 (not 9885).
# Use certbot for TLS or terminate TLS on a separate layer.

upstream bergamota_upstream {
    server 127.0.0.1:3027;
    keepalive 16;
}

server {
    listen 80;
    server_name bergamota.dev www.bergamota.dev;
    return 301 https://bergamota.dev$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bergamota.dev;

    # ssl_certificate /etc/letsencrypt/live/bergamota.dev/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/bergamota.dev/privkey.pem;

    location / {
        proxy_pass http://bergamota_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/token-optimization/acp/events {
        proxy_pass http://bergamota_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
    }
}

server {
    listen 443 ssl http2;
    server_name www.bergamota.dev;
    return 301 https://bergamota.dev$request_uri;
}
